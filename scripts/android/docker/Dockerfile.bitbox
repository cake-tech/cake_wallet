ARG BASE_IMAGE
FROM --platform=linux/amd64 ${BASE_IMAGE} AS build

COPY scripts/docker/git-credential-github.sh /usr/local/bin/git-credential-github
RUN chmod 755 /usr/local/bin/git-credential-github \
    && git config --system credential.helper /usr/local/bin/git-credential-github

RUN mkdir -p /w/scripts
COPY scripts/build_bitbox_flutter.sh /w/scripts/build_bitbox_flutter.sh
RUN --mount=type=secret,id=github_token,required=false,mode=0444 \
    cd /w/scripts && /w/scripts/build_bitbox_flutter.sh

FROM --platform=linux/amd64 alpine
COPY --from=build /w /w
