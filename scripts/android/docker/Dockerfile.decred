ARG BASE_IMAGE
ARG TORCH_IMAGE

FROM ${TORCH_IMAGE} AS torch_source

FROM --platform=linux/amd64 ${BASE_IMAGE} AS build

COPY scripts/docker/git-credential-github.sh /usr/local/bin/git-credential-github
RUN chmod 755 /usr/local/bin/git-credential-github \
    && git config --system credential.helper /usr/local/bin/git-credential-github

RUN mkdir -p /w/scripts/android
RUN mkdir -p /w/cw_decred/lib/api
COPY --from=torch_source /w/scripts/torch_dart /w/scripts/torch_dart
COPY cw_core/pubspec.yaml /w/cw_core/pubspec.yaml
COPY cw_decred/pubspec.yaml /w/cw_decred/pubspec.yaml
COPY pubspec_overrides.yaml /w/cw_decred/pubspec_overrides.yaml
COPY scripts/android/build_decred.sh /w/scripts/android/build_decred.sh
RUN --mount=type=secret,id=github_token,required=false,mode=0444 \
    /w/scripts/android/build_decred.sh

FROM --platform=linux/amd64 alpine
COPY --from=build /w /w
