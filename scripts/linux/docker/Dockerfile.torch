ARG BASE_IMAGE

FROM --platform=linux/amd64 ${BASE_IMAGE} AS build

COPY scripts/docker/git-credential-github.sh /usr/local/bin/git-credential-github
RUN chmod 755 /usr/local/bin/git-credential-github \
    && git config --system credential.helper /usr/local/bin/git-credential-github

COPY scripts/prepare_simplybs.sh /w/scripts/prepare_simplybs.sh
COPY scripts/prepare_torch.sh /w/scripts/prepare_torch.sh
COPY scripts/linux/build_torch.sh /w/scripts/linux/build_torch.sh

RUN sudo chown -R builder:builder /w /root
USER builder
ENV HOME=/home/builder
ENV USER=builder

ARG TARGET
RUN --mount=type=secret,id=github_token,required=false,mode=0444 \
    --mount=type=secret,id=simplybs_token,env=SIMPLYBS_TOKEN,required=true \
    if [ -n "$TARGET" ]; then \
      /w/scripts/linux/build_torch.sh "$TARGET"; \
    else \
      /w/scripts/linux/build_torch.sh; \
    fi \
    && rm -rf /w/scripts/torch_dart/simplybs

FROM --platform=linux/amd64 alpine
COPY --from=build /w /w
