ARG BASE_IMAGE

FROM --platform=linux/amd64 ${BASE_IMAGE} AS build

COPY scripts/functions.sh /w/scripts/functions.sh
COPY scripts/prepare_moneroc.sh /w/scripts/prepare_moneroc.sh
COPY scripts/ios/build_monero_all.sh /w/scripts/ios/build_monero_all.sh

ARG UID=10001
ARG GID=10001
ARG USER=builder
RUN groupadd -g "$GID" "$USER" && \
    useradd  -m -u "$UID" -g "$GID" -s /bin/bash "$USER"

RUN sudo chown $UID:$GID -R /w /root
USER builder

ARG COIN
ARG TARGET
ENV COIN=$COIN
ENV TARGET=$TARGET
RUN /w/scripts/ios/build_monero_all.sh \
    && ls /w/scripts/monero_c/release/*/${TARGET}/lib${COIN}_wallet2_api_c.dylib

FROM --platform=linux/amd64 alpine
COPY --from=build /w/scripts/monero_c/release /w/scripts/monero_c/release
